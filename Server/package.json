{
  "name": "ai-document-assistant",
  "version": "1.0.0",
  "description": "Backend-first RAG application to upload PDFs and ask questions about them using Gemini, LangChain, and ChromaDB.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@langchain/textsplitters": "^1.0.1",
    "chromadb": "^3.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
